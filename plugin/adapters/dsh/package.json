{
  "name": "miqipet-dsh",
  "version": "0.5.0",
  "description": "MiqiPet: shows each coding session as a desk pet, on the desktop and on the ESP32 desk screen (DeepSeek Harness)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "cordis.patch.yml",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepack": "mkdir -p scripts && cp ../../scripts/hook.py ../../scripts/daemon.py scripts/",
    "pack:tarball": "node pack.mjs"
  }
}
